# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
# Any out-of-source build tree, not just the default name. `build-container/` is the one the
# container's own toolchain writes — same sources, different ABI (the image is Python 3.11 and
# the host 3.10), and CMake caches the interpreter it configured against, so it has to be a
# second tree rather than a reuse. Ignoring only `build/` let 118k lines of CMake compiler-probe
# output reach a `git add -A`.
build-*/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Native build ---------------------------------------------------------
*.so
*.o
compile_commands.json
.cache/

# --- Model artefacts ------------------------------------------------------
# Weights and engines are host-specific and large; they belong in object storage.
*.engine
*.plan
*.onnx
*.pth
*.pt
*.trt

# --- Run artefacts --------------------------------------------------------
.artifacts/
logs/
*.log

# --- Editors --------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
